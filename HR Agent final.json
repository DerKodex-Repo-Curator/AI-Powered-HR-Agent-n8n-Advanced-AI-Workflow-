    {
      "parameters": {
        "jsCode": "// ── 1) سحب البيانات من نود الـ Merge ──\n// الميرج بيجمع كل الـ Items اللي جاية من الـ 3 مسارات في قائمة واحدة\nconst allItems = $input.all();\n\n// تصنيف البيانات بناءً على الحقول المميزة لكل نوع\nconst calendarItems = allItems.filter(i => i.json.hour_from !== undefined && i.json.calendar_id !== undefined);\nconst employeeItems = allItems.filter(i => i.json.resource_calendar_id !== undefined && i.json.id !== undefined);\nconst attendanceItems = allItems.filter(i => i.json.employee_id !== undefined && (i.json.check_in !== undefined || i.json.display_name !== undefined));\n\n// لو مفيش حضور نرجع خطأ واضح\nif (!attendanceItems.length) {\n  return [{\n    json: {\n      error: \"لا توجد بيانات حضور واصلة لنود الكود.\",\n      counts: {\n        totalItemsFromMerge: allItems.length,\n        calendarFound: calendarItems.length,\n        employeeFound: employeeItems.length,\n        attendanceFound: attendanceItems.length\n      }\n    }\n  }];\n}\n\n// ── 2) وظائف الحسابات ──\nfunction parseDisplay(display) {\n  const m = String(display || \"\").match(/from\\s+(\\d{1,2}):(\\d{2})(?::(\\d{2}))?\\s*(AM|PM)/i);\n  if (!m) return null;\n  let h = Number(m[1]);\n  const min = Number(m[2]);\n  const ampm = m[4].toUpperCase();\n  if (ampm === \"PM\" && h < 12) h += 12;\n  if (ampm === \"AM\" && h === 12) h = 0;\n  return { h, min };\n}\n\nfunction getDistance(lat1, lon1, lat2, lon2) {\n  const R = 6371000;\n  const dLat = (lat2 - lat1) * Math.PI / 180;\n  const dLon = (lon2 - lon1) * Math.PI / 180;\n  const a = Math.sin(dLat / 2) * Math.sin(dLat / 2) +\n    Math.cos(lat1 * Math.PI / 180) * Math.cos(lat2 * Math.PI / 180) *\n    Math.sin(dLon / 2) * Math.sin(dLon / 2);\n  return R * 2 * Math.atan2(Math.sqrt(a), Math.sqrt(1 - a));\n}\n\n// ── 3) بناء خريطة الورديات ──\nconst shiftMap = {};\ncalendarItems.forEach(item => {\n  const calId = Array.isArray(item.json.calendar_id) ? item.json.calendar_id[0] : item.json.calendar_id;\n  const hf = Number(item.json.hour_from);\n  if (calId && (shiftMap[calId] === undefined || hf < shiftMap[calId])) {\n    shiftMap[calId] = Math.floor(hf);\n  }\n});\n\n// ── 4) ربط الموظفين (شيفت + إيميل) ──\nconst empShiftMap = {};\nconst empEmailMap = {};\nemployeeItems.forEach(emp => {\n  const calId = Array.isArray(emp.json.resource_calendar_id)\n    ? emp.json.resource_calendar_id[0]\n    : emp.json.resource_calendar_id;\n  const empId = emp.json.id;\n  empShiftMap[empId] = shiftMap[calId] ?? 9;\n  empEmailMap[empId] = emp.json.work_email || '';\n});\n\n// ── 5) معالجة الحضور ──\nconst COMPANY_LAT = 30.015309;\nconst COMPANY_LNG = 31.436322;\nconst RADIUS_METERS = 3000;\n\nreturn attendanceItems.map(item => {\n  const a = item.json;\n  const t = parseDisplay(a.display_name);\n  if (!t) return null;\n\n  const empId = Array.isArray(a.employee_id) ? a.employee_id[0] : a.employee_id;\n  const shiftHour = empShiftMap[empId] ?? 9;\n  const lateMinutesRaw = (t.h * 60 + t.min) - (shiftHour * 60);\n\n  const lat = parseFloat(a.in_latitude);\n  const lng = parseFloat(a.in_longitude);\n\n  let locationStatus = \"no_gps\";\n  let distanceText = null;\n\n  if (Number.isFinite(lat) && Number.isFinite(lng)) {\n    const dist = getDistance(lat, lng, COMPANY_LAT, COMPANY_LNG);\n    locationStatus = dist <= RADIUS_METERS ? \"in_office\" : \"outside\";\n    distanceText = dist < 1000 ? `${Math.round(dist)} متر` : `${(dist / 1000).toFixed(2)} كم`;\n  }\n\n  return {\n    json: {\n      employee_id: empId,\n      employeeName: Array.isArray(a.employee_id) ? a.employee_id[1] : \"Unknown\",\n      work_email: empEmailMap[empId] || '',\n      display_time_hhmm: `${String(t.h).padStart(2, '0')}:${String(t.min).padStart(2, '0')}`,\n      shiftStart: `${shiftHour}:00`,\n      lateMinutes: lateMinutesRaw > 0 ? lateMinutesRaw : 0,\n      locationStatus,\n      distanceText,\n      in_location: a.in_location ?? null\n    }\n  };\n}).filter(Boolean);"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1152,
        160
      ],
      "id": "281db6e7-8b14-4a0a-a672-373d91564ab3",
      "name": "Parse Display Time"
    },
    {
      "parameters": {
        "jsCode": "const items = $input.all();\n\nconst toNum = (v) => {\n  const n = Number(v);\n  return Number.isFinite(n) ? n : 0;\n};\nconst norm = (v) => String(v ?? '').trim().toLowerCase();\n\nconst late = items\n  .filter(i => toNum(i.json.lateMinutes) > 0)\n  .sort((a, b) => toNum(b.json.lateMinutes) - toNum(a.json.lateMinutes));\n\nconst outside = items\n  .filter(i => norm(i.json.locationStatus) === 'outside');\n\nconst total = items.length;\n\nconst date = new Date().toLocaleDateString('en-CA');\nconst generatedAt = new Date().toLocaleString('ar-EG');\n\nconst lateRows = late.map((e, idx) => `\n  <tr>\n    <td style=\"padding:10px; border-bottom:1px solid #eee;\">${idx + 1}</td>\n    <td style=\"padding:10px; border-bottom:1px solid #eee; font-weight:600;\">${e.json.employeeName ?? '-'}</td>\n    <td style=\"padding:10px; border-bottom:1px solid #eee;\">${e.json.display_time_hhmm ?? '-'}</td>\n    <td style=\"padding:10px; border-bottom:1px solid #eee;\">${e.json.shiftStart ?? '-'}</td>\n    <td style=\"padding:10px; border-bottom:1px solid #eee; font-weight:700; color:#e65100;\">\n      ${toNum(e.json.lateMinutes)} دقيقة\n    </td>\n  </tr>\n`).join('');\n\nconst outsideRows = outside.map((e, idx) => `\n  <tr>\n    <td style=\"padding:10px; border-bottom:1px solid #eee;\">${idx + 1}</td>\n    <td style=\"padding:10px; border-bottom:1px solid #eee; font-weight:600;\">${e.json.employeeName ?? '-'}</td>\n    <td style=\"padding:10px; border-bottom:1px solid #eee;\">${e.json.display_time_hhmm ?? '-'}</td>\n    <td style=\"padding:10px; border-bottom:1px solid #eee; color:#c62828; font-weight:700;\">\n      ${e.json.distanceText ?? '-'}\n    </td>\n    <td style=\"padding:10px; border-bottom:1px solid #eee;\">${e.json.in_location ?? 'غير محدد'}</td>\n  </tr>\n`).join('');\n\nconst html = `\n<div dir=\"rtl\" style=\"font-family:Arial, sans-serif; background:#fafafa; padding:20px;\">\n  <div style=\"max-width:900px; margin:0 auto; background:#fff; border:1px solid #eee; border-radius:12px; overflow:hidden;\">\n    \n    <div style=\"padding:18px 20px; background:linear-gradient(90deg,#1a1a2e,#2b2b55); color:#fff;\">\n      <div style=\"font-size:20px; font-weight:700;\">📊 تقرير الحضور اليومي — ${date}</div>\n      <div style=\"opacity:.85; margin-top:6px; font-size:12px;\">تم إنشاء التقرير تلقائياً — ${generatedAt}</div>\n    </div>\n\n    <!-- Summary cards -->\n    <div style=\"display:flex; gap:12px; padding:16px 20px; flex-wrap:wrap;\">\n      <div style=\"flex:1; min-width:180px; background:#e8f5e9; border:1px solid #c8e6c9; padding:14px; border-radius:10px;\">\n        <div style=\"font-size:26px; font-weight:800; color:#2e7d32;\">${total}</div>\n        <div style=\"color:#2e7d32; font-weight:600;\">إجمالي الحضور</div>\n      </div>\n      <div style=\"flex:1; min-width:180px; background:#fff3e0; border:1px solid #ffe0b2; padding:14px; border-radius:10px;\">\n        <div style=\"font-size:26px; font-weight:800; color:#e65100;\">${late.length}</div>\n        <div style=\"color:#e65100; font-weight:600;\">متأخرين</div>\n      </div>\n      <div style=\"flex:1; min-width:180px; background:#ffebee; border:1px solid #ffcdd2; padding:14px; border-radius:10px;\">\n        <div style=\"font-size:26px; font-weight:800; color:#c62828;\">${outside.length}</div>\n        <div style=\"color:#c62828; font-weight:600;\">خارج نطاق الشركة</div>\n      </div>\n    </div>\n\n    <!-- Late table -->\n    <div style=\"padding:0 20px 18px;\">\n      <div style=\"display:flex; align-items:center; justify-content:space-between; margin:8px 0 10px;\">\n        <h3 style=\"margin:0; color:#e65100;\">⏰ كشف المتأخرين</h3>\n        <span style=\"font-size:12px; color:#777;\">مرتّب حسب أكبر تأخير</span>\n      </div>\n\n      <table style=\"width:100%; border-collapse:collapse; border:1px solid #eee; border-radius:10px; overflow:hidden;\">\n        <thead>\n          <tr style=\"background:#ff8c00; color:#fff;\">\n            <th style=\"padding:10px; text-align:right;\">#</th>\n            <th style=\"padding:10px; text-align:right;\">الاسم</th>\n            <th style=\"padding:10px; text-align:right;\">وقت الحضور</th>\n            <th style=\"padding:10px; text-align:right;\">وقت الشيفت</th>\n            <th style=\"padding:10px; text-align:right;\">التأخير</th>\n          </tr>\n        </thead>\n        <tbody>\n          ${lateRows || `<tr><td colspan=\"5\" style=\"padding:12px; text-align:center; color:#555;\">لا يوجد متأخرين اليوم ✅</td></tr>`}\n        </tbody>\n      </table>\n    </div>\n\n    <!-- Outside table -->\n    <div style=\"padding:0 20px 22px;\">\n      <h3 style=\"margin:0 0 10px; color:#c62828;\">📍 كشف خارج النطاق</h3>\n\n      <table style=\"width:100%; border-collapse:collapse; border:1px solid #eee; border-radius:10px; overflow:hidden;\">\n        <thead>\n          <tr style=\"background:#ff4444; color:#fff;\">\n            <th style=\"padding:10px; text-align:right;\">#</th>\n            <th style=\"padding:10px; text-align:right;\">الاسم</th>\n            <th style=\"padding:10px; text-align:right;\">وقت الحضور</th>\n            <th style=\"padding:10px; text-align:right;\">المسافة</th>\n            <th style=\"padding:10px; text-align:right;\">الموقع</th>\n          </tr>\n        </thead>\n        <tbody>\n          ${outsideRows || `<tr><td colspan=\"5\" style=\"padding:12px; text-align:center; color:#555;\">الجميع داخل نطاق الشركة ✅</td></tr>`}\n        </tbody>\n      </table>\n\n      <div style=\"margin-top:10px; font-size:11px; color:#888;\">\n        ملاحظة: \"خارج النطاق\" بناءً على GPS والمسافة المحددة في الإعدادات.\n      </div>\n    </div>\n\n  </div>\n</div>\n`;\n\nreturn [{\n  json: {\n    to: \"ashrqat@thelvx.com\",\n    subject: `📊 تقرير الحضور — ${date} | ${late.length} متأخر | ${outside.length} خارج النطاق`,\n    html\n  }\n}];"
      },
