        240
      ],
      "id": "0e3d88a3-e5db-4dc3-9f09-3bc45c986abe",
      "name": "Get many items",
      "credentials": {
        "odooApi": {
          "id": "Zb4G4MMWYWjxblp3",
          "name": "Admin Credititional"
        }
